/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. KHAJE IDP nopmi";
	compatible = "qcom,khaje-idp\0qcom,khaje\0qcom,idp";
	qcom,msm-id = <0x206 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x10022 0x00>;

	memory {
		ddr_device_type = <0x07>;
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x3cc00000 0x01 0x00 0x00 0xc0000000 0x00 0x80000000 0x00 0x80000000>;
	};

	ddr-regions {
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
	};

	aliases {
		swr1 = "/soc/spf_core_platform/bolero-codec/rx-macro@a600000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/bolero-codec/va-macro@a730000/va_swr_master";
		mmc0 = "/soc/sdhci@4744000";
		mmc1 = "/soc/sdhci@4784000";
		ufshc1 = "/soc/ufshc@4804000";
		serial0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a90000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a8c000";
		phandle = <0x127>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x11>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x04>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x128>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x129>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x01>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x12>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12a>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12b>;
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x02>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x13>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12c>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12d>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x03>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x09>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x14>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12e>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12f>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			cpu-idle-states = <0x0a>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			next-level-cache = <0x0c>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0d>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x0c>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x130>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x131>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x101>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			cpu-idle-states = <0x0a>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0c>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0d>;
			phandle = <0x16>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x132>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x133>;
			};
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x102>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			next-level-cache = <0x0c>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0d>;
			phandle = <0x17>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x134>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x135>;
			};
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x103>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			enable-method = "psci";
			cpu-idle-states = <0x0a>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			next-level-cache = <0x0c>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0d>;
			phandle = <0x18>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x136>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x137>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x12>;
				};

				core2 {
					cpu = <0x13>;
				};

				core3 {
					cpu = <0x14>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};

				core3 {
					cpu = <0x18>;
				};
			};
		};
	};

	idle-states {

		silver-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x129>;
			exit-latency-us = <0x144>;
			min-residency-us = <0x456>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x02>;
		};

		gold-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x122>;
			exit-latency-us = <0x178>;
			min-residency-us = <0x49e>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x0a>;
		};

		silver-cluster-d3 {
			compatible = "domain-idle-state";
			idle-state-name = "pwr-l2-pc";
			entry-latency-us = <0x280>;
			exit-latency-us = <0x680>;
			min-residency-us = <0x1f9e>;
			arm,psci-suspend-param = <0x41000043>;
			phandle = <0x1c>;
		};

		gold-cluster-d3 {
			compatible = "domain-idle-state";
			idle-state-name = "perf-l2-pc";
			entry-latency-us = <0x320>;
			exit-latency-us = <0x846>;
			min-residency-us = <0x1cd0>;
			arm,psci-suspend-param = <0x41000043>;
			phandle = <0x1d>;
		};

		cluster-e1 {
			compatible = "domain-idle-state";
			idle-state-name = "cci-ret";
			entry-latency-us = <0x6c>;
			exit-latency-us = <0x1c2>;
			min-residency-us = <0x99>;
			arm,psci-suspend-param = <0x42000043>;
			phandle = <0x1f>;
		};

		cluster-e3 {
			compatible = "domain-idle-state";
			idle-state-name = "cci-pc";
			entry-latency-us = <0x2a4f>;
			exit-latency-us = <0x119a>;
			min-residency-us = <0x3bea>;
			arm,psci-suspend-param = <0x42000343>;
			phandle = <0x20>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cpu-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x19>;
			phandle = <0x03>;
		};

		cpu-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x19>;
			phandle = <0x07>;
		};

		cpu-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x19>;
			phandle = <0x08>;
		};

		cpu-pd3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x19>;
			phandle = <0x09>;
		};

		cpu-pd4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1a>;
			phandle = <0x0b>;
		};

		cpu-pd5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1a>;
			phandle = <0x0e>;
		};

		cpu-pd6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1a>;
			phandle = <0x0f>;
		};

		cpu-pd7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1a>;
			phandle = <0x10>;
		};

		cluster-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x19>;
		};

		cluster-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1d>;
			phandle = <0x1a>;
		};

		cluster-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			phandle = <0x1b>;
		};

		cluster-pd3 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x20>;
			phandle = <0x1e>;
		};
	};

	firmware {
		phandle = <0x138>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x21 0x13000>;
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/4744000.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "disabled";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x139>;

		hyp_region@45700000 {
			no-map;
			reg = <0x00 0x45700000 0x00 0x600000>;
			phandle = <0x13a>;
		};

		xbl_aop_region@45e00000 {
			no-map;
			reg = <0x00 0x45e00000 0x00 0x140000>;
			phandle = <0x13b>;
		};

		sec_apps_region@45fff000 {
			no-map;
			reg = <0x00 0x45fff000 0x00 0x1000>;
			phandle = <0x13c>;
		};

		smem_region@46000000 {
			no-map;
			reg = <0x00 0x46000000 0x00 0x200000>;
			phandle = <0xca>;
		};

		removed_region@60000000 {
			no-map;
			reg = <0x00 0x60000000 0x00 0x3900000>;
			phandle = <0x13d>;
		};

		modem_region@4ab00000 {
			no-map;
			reg = <0x00 0x4ab00000 0x00 0x6900000>;
			phandle = <0xda>;
		};

		wlan_msa_region@51900000 {
			no-map;
			reg = <0x00 0x51900000 0x00 0x100000>;
			phandle = <0x13e>;
		};

		cdsp_regions@51a00000 {
			no-map;
			reg = <0x00 0x51a00000 0x00 0x1e00000>;
			phandle = <0x96>;
		};

		pil_adsp_region@53800000 {
			no-map;
			reg = <0x00 0x53800000 0x00 0x1e00000>;
			phandle = <0x91>;
		};

		ipa_fw_region@55600000 {
			no-map;
			reg = <0x00 0x55600000 0x00 0x10000>;
			phandle = <0xe0>;
		};

		ipa_gsi_region@55610000 {
			no-map;
			reg = <0x00 0x55610000 0x00 0x5000>;
			phandle = <0x13f>;
		};

		gpu_region@55615000 {
			no-map;
			reg = <0x00 0x55615000 0x00 0x2000>;
			phandle = <0x140>;
		};

		video_region@55617000 {
			no-map;
			reg = <0x00 0x55617000 0x00 0x700000>;
			phandle = <0x141>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x89>;
		};

		non_secure_display_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0xa400000>;
			alignment = <0x00 0x400000>;
			phandle = <0xf8>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x87>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x88>;
		};

		cdsp_sec_regions@46200000 {
			no-map;
			reg = <0x00 0x46200000 0x00 0x1e00000>;
			phandle = <0xf6>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0xf7>;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0xd1>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
			phandle = <0x99>;
		};

		ramoops_region {
			compatible = "ramoops";
			alloc-ranges = <0x00 0x00 0xffffffff 0xffffffff>;
			size = <0x00 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
			phandle = <0x142>;
		};

		audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0xf9>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0x100>;
		};

		va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x1000000>;
			phandle = <0xc8>;
		};

		dfps_data_region@5cf00000 {
			phandle = <0x347>;
			label = "dfps_data_region";
			reg = <0x00 0x5cf00000 0x00 0x100000>;
		};

		splash_region@5c000000 {
			phandle = <0x358>;
			label = "cont_splash_region";
			reg = <0x00 0x5c000000 0x00 0xf00000>;
		};
	};

	chosen {
		linux,initrd-end = <0x00 0x456fe3fc>;
		linux,initrd-start = <0x00 0x44986000>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "lpm_levels.sleep_disabled=1 console=ttyMSM0,115200n8 msm_rtb.filter=0x237 log_buf_len=2048k service_locator.enable=1 swiotlb=2048 loop.max_part=7 cpufreq.default_governor=performance rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off export_pmu_events movable_node ftrace_dump_on_oops ssbd=force-off disable_dma32=on cgroup.memory=nokmem,nosocket video=vfb:640x400,bpp=32,memsize=3072000 bootconfig  qca_cld3_wlan.wifiaddr=C8:05:A4:73:47:E6 msm_drm.dsi_display0=qcom,mdss_dsi_panel_p255_inx_fhd_video: rootwait ro init=/init silent_boot.mode=nonsilent";
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x143>;

		hwevent {
			compatible = "qcom,coresight-hwevent";
			coresight-name = "coresight-hwevent";
			coresight-csr = <0x22>;
			clocks = <0x23 0x08>;
			clock-names = "apb_pclk";
		};

		tgu@9900000 {
			compatible = "arm,primecell";
			arm,primecell-periphid = <0x3b999>;
			reg = <0x9900000 0x1000>;
			reg-names = "tgu-base";
			tgu-steps = <0x03>;
			tgu-conditions = <0x04>;
			tgu-regs = <0x08>;
			tgu-timer-counters = <0x08>;
			interrupts = <0x00 0x35 0x01 0x00 0x36 0x01 0x00 0x37 0x01 0x00 0x38 0x01>;
			coresight-name = "coresight-tgu-apss";
			clocks = <0x23 0x08>;
			clock-names = "apb_pclk";
			phandle = <0x144>;
		};

		csr@8001000 {
			compatible = "qcom,coresight-csr";
			reg = <0x8001000 0x1000>;
			reg-names = "csr-base";
