/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. KHAJE IDP nopmi";
	compatible = "qcom,khaje-idp\0qcom,khaje\0qcom,idp";
	qcom,msm-id = <0x206 0x10000>;
	qcom,board-id = <0x10022 0x00>;
	qcom,pmic-id = <0x2d 0x00 0x00 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			pm6125-tz {

				cooling-maps {

					trip0_cpu0 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x07 0x07>;
					};

					trip0_cpu4 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x06 0xffffffff>;
					};

					trip1_cpu1 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu2 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu3 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu4 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu5 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu6 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};

					trip1_cpu7 {
						trip = <0xffffffff>;
						cooling-device = <0xffffffff 0x01 0x01>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-0 = <0xffffffff 0xffffffff 0x01>;

			rf_pa1_therm {
				reg = <0x55>;
				label = "rf_pa1_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <0xc8>;
				qcom,pre-scaling = <0x01 0x01>;
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			rf_pa1_therm {
				reg = <0x03>;
				io-channels = <0xffffffff 0x55>;
				qcom,ratiometric;
				qcom,hw-settle-time-us = <0xc8>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			batt_therm {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "user_space";
				thermal-sensors = <0xffffffff 0x03>;
				wake-capable-sensor;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			rf_pa1_therm {

				rf_pa1_therm_default {
					pins = "gpio7";
					bias-high-impedance;
					phandle = <0x01>;
				};
			};

			key_vol_up {

				key_vol_up_default {
					pins = "gpio5";
					function = "normal";
					input-enable;
					bias-pull-up;
					power-source = <0x00>;
					phandle = <0x02>;
				};
			};

			eldo9_pin {

				gpio@c000 {
					pins = "gpio1";
					function = "normal";
					qcom,drive-strength = <0x02>;
					power-source = <0x00>;
					bias-disable;
					output-high;
					phandle = <0x03>;
				};
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <0x02>;

				vol_up {
					label = "volume_up";
					gpios = <0xffffffff 0x05 0x01>;
					gpio-supply = <0xffffffff>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					linux,can-disable;
					debounce-interval = <0x0f>;
					gpio-key,wakeup;
				};

				hall_key {
					label = "hall_key";
					gpios = <0xffffffff 0x42 0x01>;
					linux,input-type = <0x05>;
					linux,code = <0x00>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
				};
			};

			vdda_usb_ss_dp_core {
				compatible = "regulator-fixed";
				status = "disabled";
				regulator-name = "vdd_supply";
				regulator-min-microvolt = <0xd6d80>;
				regulator-max-microvolt = <0xd6d80>;
				enable-active-high;
				gpio = <0xffffffff 0x01 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <0x03>;
				phandle = <0x04>;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-supply = <0x04>;
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			awinic@64 {
				compatible = "awinic,aw2016_led";
				status = "disabled";
				reg = <0x64>;

				awinic,red {
					awinic,name = "red";
					awinic,id = <0x00>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,rise-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,fall-time-ms = <0x06>;
					awinic,off-time-ms = <0x04>;
				};

				awinic,green {
					awinic,name = "green";
					awinic,id = <0x01>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,rise-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,fall-time-ms = <0x06>;
					awinic,off-time-ms = <0x04>;
				};

				awinic,blue {
					awinic,name = "blue";
					awinic,id = <0x02>;
					awinic,imax = <0x02>;
					awinic,led-current = <0x03>;
					awinic,max-brightness = <0xff>;
					awinic,rise-time-ms = <0x06>;
					awinic,hold-time-ms = <0x00>;
					awinic,fall-time-ms = <0x06>;
					awinic,off-time-ms = <0x04>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-supply = <0xffffffff>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0x8b290>;
			vdd-io-supply = <0xffffffff>;
			qcom,vdd-io-always-on;
			qcom,vdd-io-lpm-sup;
			qcom,vdd-io-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-io-current-level = <0x00 0x4f588>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <0xffffffff>;
			pinctrl-1 = <0xffffffff>;
			status = "ok";
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-supply = <0xffffffff>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <0xffffffff>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			vdd-io-bias-supply = <0xffffffff>;
			qcom,vdd-io-bias-voltage-level = <0x132a40 0x132a40>;
			qcom,vdd-io-bias-current-level = <0x00 0x1770>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <0xffffffff>;
			pinctrl-1 = <0xffffffff>;
			cd-gpios = <0xffffffff 0x58 0x00>;
			status = "ok";
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {

			simtray {
				compatible = "longcheer,simtray-status";
				status-gpio = <0xffffffff 0x58 0x00>;
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-khaje";
			vdda-phy-supply = <0xffffffff>;
			vdda-pll-supply = <0xffffffff>;
			vdda-phy-max-microamp = <0x14ec4>;
			vdda-pll-max-microamp = <0x477c>;
			status = "ok";
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			vdd-hba-supply = <0xffffffff>;
			vdd-hba-fixed-regulator;
			vcc-supply = <0xffffffff>;
			vcc-max-microamp = "\0\f5";
			vccq2-supply = <0xffffffff>;
			vccq2-max-microamp = "\0\f5";
			qcom,vddp-ref-clk-supply = <0xffffffff>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			reset-gpios = <0xffffffff 0x71 0x01>;
			resets = <0xffffffff 0x04>;
			reset-names = "rst";
			status = "ok";
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			qcom,i2c-touch-active = "synaptics,tcm-i2c";

			synaptics_tcm@20 {
				compatible = "synaptics,tcm-i2c";
				reg = <0x20>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x50 0x2008>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
				pinctrl-0 = <0xffffffff 0xffffffff>;
				pinctrl-1 = <0xffffffff 0xffffffff>;
				pinctrl-2 = <0xffffffff>;
				synaptics,irq-gpio = <0xffffffff 0x50 0x2008>;
				synaptics,irq-on-state = <0x00>;
				synaptics,reset-gpio = <0xffffffff 0x56 0x00>;
				synaptics,reset-on-state = <0x00>;
				synaptics,reset-active-ms = <0x14>;
				synaptics,reset-delay-ms = <0xc8>;
				synaptics,power-delay-ms = <0xc8>;
				synaptics,ubl-i2c-addr = <0x20>;
				synaptics,extend_report;
				synaptics,firmware-name = "synaptics_firmware_k.img";
			};

			novatek@62 {
				reg = <0x62>;
				status = "ok";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x50 0x2008>;
				pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
				pinctrl-0 = <0xffffffff 0xffffffff>;
				pinctrl-1 = <0xffffffff 0xffffffff>;
				pinctrl-2 = <0xffffffff>;
				novatek,reset-gpio = <0xffffffff 0x56 0x00>;
				novatek,irq-gpio = <0xffffffff 0x50 0x2008>;
			};
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {

			synaptics_tcm@20 {
				status = "disabled";
			};

			novatek@62 {
				status = "disabled";
			};
		};
	};

	fragment@17 {
		target = <0xffffffff>;

		__overlay__ {

			rt1711h_int_n {
				phandle = <0x0a>;

				mux {
					pins = "gpio93";
					function = "gpio";
				};

				config {
					pins = "gpio93";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};
		};
	};

	fragment@18 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			rt1711h@4e {
				#io-channel-cells = <0x01>;
				compatible = "richtek,rt1711h";
				reg = <0x4e>;
				status = "ok";
				tcpc-dual,supported_modes = <0x00>;
				rt-tcpc,name = "type_c_port0";
				rt-tcpc,role_def = <0x05>;
				rt-tcpc,rp_level = <0x00>;
				rt-tcpc,vconn_supply = <0x01>;
				rt1711pd,intr_gpio = <0xffffffff 0x5d 0x00>;
				rt1711pd,intr_gpio_num = <0x5d>;
				phandle = <0x0b>;

				pd-data {
					pd,vid = <0x29cf>;
					pd,pid = <0x1711>;
					pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
					pd,mfrs = "RichtekTCPC";
					pd,charging_policy = <0x31>;
					pd,source-pdo-size = <0x01>;
					pd,source-pdo-data = <0x19078>;
					pd,sink-pdo-size = <0x01>;
					pd,sink-pdo-data = <0x190c8>;
					pd,id-vdo-size = <0x06>;
					pd,id-vdo-data = <0xd14029cf 0x00 0x17110000 0x61000000 0x00 0x41000000>;
					bat,nr = <0x01>;
					pd,country_nr = <0x00>;

					bat-info0 {
						bat,vid = <0x29cf>;
						bat,pid = <0x1711>;
						bat,mfrs = "bat1";
						bat,design_cap = <0xbb8>;
					};
				};

				dpm_caps {
					local_dr_power;
					local_dr_data;
					local_usb_comm;
					local_no_suspend;
					local_vconn_supply;
					attempt_enter_dp_mode;
					attempt_discover_cable;
					attempt_discover_id;
					pr_check = <0x00>;
					dr_check = <0x00>;
				};

				displayport {
					1st_connection = "dfp_d";
					2nd_connection = "dfp_d";
					signal,dp_v13;
					typec,receptacle;

					ufp_d {
					};

					dfp_d {
						pin_assignment,mode_c;
						pin_assignment,mode_d;
						pin_assignment,mode_e;
					};
				};
			};

			aw35615@22 {
				compatible = "awinic,aw35615";
				reg = <0x22>;
				awinic,int_n = <0xffffffff 0x5d 0x00>;
				aw35615,snk_pdo_size = <0x01>;
				aw35615,snk_pdo_vol = <0x2328>;
				aw35615,snk_pdo_cur = <0x7d0>;
				aw35615,src_pdo_size = <0x01>;
				aw35615,src_pdo_vol = <0x1388>;
				aw35615,src_pdo_cur = <0x3e8>;
				aw35615,snk_tog_time = <0x38>;
				aw35615,src_tog_time = <0x24>;
				status = "okay";
				phandle = <0x0c>;
			};
		};
	};

	fragment@19 {
		target = <0xffffffff>;

		__overlay__ {

			rt-pd-manager {
				#io-channel-cells = <0x01>;
				compatible = "richtek,rt-pd-manager";
				io-channels = <0x05 0x0a 0x05 0x04 0x05 0x0c 0x05 0x0b 0x05 0x00 0x05 0x03 0x05 0x01 0x05 0x1f 0x05 0x1e 0x05 0x92>;
				io-channel-names = "usb_real_type\0usb_pd_active\0usb_pd_voltage_min\0usb_pd_voltage_max\0usb_pd_current_max\0usb_typec_cc_orientation\0usb_typec_mode\0usb_pd_usb_suspend_supported\0usb_pd_in_hard_reset\0batt_protected";
				phandle = <0x06>;
			};
		};
	};

	fragment@20 {
		target = <0xffffffff>;

		__overlay__ {
			extcon = <0x06 0xffffffff>;
		};
	};

	fragment@21 {
		target = <0xffffffff>;

		__overlay__ {

			main_chg_int_default {
				phandle = <0x0d>;

				mux {
					pins = "gpio36";
					function = "gpio";
				};

				config {
					pins = "gpio36";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			slave_chg_int_default {
				phandle = <0x0e>;

				mux {
					pins = "gpio84";
					function = "gpio";
				};

				config {
					pins = "gpio84";
					drive-strength = <0x02>;
					bias-pull-up;
					input-enable;
				};
			};

			slave_chg_ce_default {
				phandle = <0x0f>;

				mux {
					pins = "gpio75";
					function = "gpio";
				};

				config {
					pins = "gpio75";
					drive-strength = <0x02>;
					bias-pull-down;
					output-low;
				};
			};
		};
	};

	fragment@22 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			mm8013c10@55 {
				#io-channel-cells = <0x01>;
				compatible = "mm8013c10";
				reg = <0x55>;
				status = "ok";
				phandle = <0x08>;
			};

			sc8960x_master@6b {
				#io-channel-cells = <0x01>;
				compatible = "southchip,sc89601d\0upm,upm6910d";
				reg = <0x6b>;
				pinctrl-names = "default";
				sc8960x,intr_gpio = <0xffffffff 0x24 0x00>;
				dpdm-supply = <0xffffffff>;
				sc8960x,charger_name = "bbc";
				sc8960x,pfm-dis = <0x00>;
				sc8960x,vsys-min = <0x05>;
				sc8960x,vbat-low-otg = <0x00>;
				sc8960x,ipre-chg = <0x02>;
				sc8960x,itermination = <0x02>;
				sc8960x,vbat-volt = <0x54>;
				sc8960x,top-off-timer = <0x00>;
				sc8960x,vrechg-volt = <0x01>;
				sc8960x,en-termination = <0x01>;
				sc8960x,wdt-timer = <0x00>;
				sc8960x,en-chg-saft-timer = <0x01>;
				sc8960x,charge-timer = <0x01>;
				sc8960x,vac-ovp = <0x03>;
				sc8960x,iboost = <0x01>;
				sc8960x,vboost = <0x0c>;
				sc8960x,vindpm-track = <0x00>;
				sc8960x,vindpm-int-mask = <0x01>;
				sc8960x,iindpm-int-mask = <0x01>;
				sc8960x,vpre-to-cc = <0x00>;
				sc8960x,auto-dpdm-en = <0x00>;
				sc8960x,ntc-pin-dis = <0x01>;
				upm,charger_name = "bbc";
				upm,intr_gpio = <0xffffffff 0x24 0x00>;
				upm,upm6910,usb-vlim = <0x125c>;
				upm,upm6910,usb-ilim = <0x7d0>;
				upm,upm6910,usb-vreg = <0x1130>;
				upm,upm6910,usb-ichg = <0x7d0>;
				upm,upm6910,precharge-current = <0xb4>;
				upm,upm6910,termination-current = <0xb4>;
				upm,upm6910,boost-voltage = <0x1388>;
				upm,upm6910,boost-current = <0x4b0>;
				upm,upm6910,vac-ovp-threshold = <0x36b0>;
				upm,upm6910,fast-iterm = <0xafc80>;
				io-channels = <0x05 0x80 0x05 0x0a 0x05 0x04 0x05 0x03 0x05 0x01 0x05 0x8c 0x07 0x81 0x05 0x74 0xffffffff 0x0d 0x05 0x94 0x05 0x95 0x05 0x96 0x05 0x97 0x05 0x92>;
				io-channel-names = "mtbf_current\0usb_real_type\0usb_pd_active\0usb_typec_cc_orientation\0usb_typec_mode\0ffc_disable\0slave_charge_enabled\0charge_type\0vbus_adc\0double_charger_logic_precharger\0double_charger_logic\0double_charger_logic_only_master_charger\0double_charger_logic_only_slave_charger\0batt_protected";
				phandle = <0x09>;
			};
		};
	};

	fragment@23 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			sc8960x_slave@6b {
				#io-channel-cells = <0x01>;
				compatible = "southchip,sc89601d_slave\0upm,upm6910d_slave";
				reg = <0x6b>;
				pinctrl-names = "default";
				sc8960x,intr_gpio = <0xffffffff 0x54 0x00>;
